{
  "corpus_version": 1,
  "about": "Labelled corpus for the correlation engine: the equivalent of the RAG's golden queries. Every case declares records in the common schema and what the engine MUST conclude from them, so tuning a knob becomes a measurement instead of an act of faith. Run: uv run python -m engine.run_eval. Data is synthetic; addresses come from the documentation ranges (RFC 5737/3849) and identities are pseudonyms (conventions §9) — no client data enters this file.",
  "expectation_types": {
    "bridges": "entities that MUST be reported as cross-source bridges (shared_indicators), optionally with a minimum family count and an expected match_type",
    "absent": "entities that must NOT be reported as bridges: ubiquitous values whose 'link' is noise",
    "ranking": "ordered pairs [a, b]: a must outrank b in the confidence-sorted output — this is what _KIND_WEIGHT is for",
    "episodes_multi_family": "how many temporal episodes spanning more than one source are expected",
    "clusters": "entities that must land in the SAME incident cluster",
    "beaconing": "destinations that must (or must not) be reported as periodic",
    "timeline": "which selection criteria must appear in the timeline, and which must not"
  },
  "cases": [
    {
