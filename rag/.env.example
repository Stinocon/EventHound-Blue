# Copiare in .env (gitignored) e compilare. Non committare valori reali.

# Token del server crawl4ai (se configurato nel container)
CRAWL4AI_API_TOKEN=

# Endpoint Qdrant — istanza DEDICATA a questo progetto (porta 6343, non il 6333 di PersonalFinance)
QDRANT_URL=http://localhost:6343
QDRANT_API_KEY=

# ---- Embedding ----
# Backend: fastembed (locale, default) | voyage | openai
EMBEDDING_BACKEND=fastembed
# Vuoto = default del backend. Per fastembed il default è intfloat/multilingual-e5-large
# (1024 dim, multilingue IT+EN, max qualità; richiede i prefissi query:/passage:, gestiti
# in Embedder._with_prefix). Alternativa più leggera/veloce su CPU (niente prefissi):
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384 dim).
EMBEDDING_MODEL=
# Chiave per i backend cloud (voyage/openai). Non serve con fastembed.
EMBEDDING_API_KEY=
# Solo per backend openai-compatibili self-hosted (es. Ollama/LM Studio):
EMBEDDING_BASE_URL=
